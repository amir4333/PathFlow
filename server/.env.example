# PathFlow Backend Server Environment Configuration
# NEVER commit production credentials or actual .env files to source control.

NODE_ENV="production"
PORT=3001
HOST="0.0.0.0"

# MANDATORY in production: PostgreSQL connection string
DATABASE_URL="postgresql://pathflow:pathflow_secret@localhost:5432/pathflow_db?schema=public"

# MANDATORY in production: JWT signing secret (minimum 32 characters, no placeholders)
AUTH_SECRET="your-cryptographically-secure-random-secret-key-32-chars"

# MANDATORY in production: Explicit frontend origins (wildcards prohibited)
# Comma-separated if multiple
CORS_ALLOWED_ORIGINS="https://app.pathflow.example.com"
