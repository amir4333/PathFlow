# PathFlow Backend Environment Configuration
# Copy this file to .env and adjust variables for your hosting environment

# Database Configuration (MySQL / MariaDB via PDO)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pathflow_db
DB_USERNAME=pathflow_user
DB_PASSWORD=change_this_password
DB_CHARSET=utf8mb4
# Table Prefix Isolation (Allows PathFlow to safely coexist in shared MySQL databases e.g. alongside WordPress 5bez_*)
DB_TABLE_PREFIX=pf_

# Authentication Secret (Used for HMAC-SHA256 JWT tokens)
AUTH_SECRET=generate_a_secure_random_key_min_32_characters

# Application Environment (production, development, test)
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:3001

# CORS Configuration
# Set to specific frontend origin (e.g. https://app.pathflow.example or http://localhost:3000)
# In development, multiple origins or localhost can be specified separated by commas
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
