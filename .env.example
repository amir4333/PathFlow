# ==========================================
# PathFlow Environment Configuration Reference
# ==========================================
# WARNING: NEVER commit actual secrets, keys, or production passwords to version control.
# Copy this file to .env for local development or set these variables in your hosting environment.

# ------------------------------------------
# AI Studio & Core Runtime Variables
# ------------------------------------------
# GEMINI_API_KEY: Required for Gemini AI API calls (automatically injected by AI Studio).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (injected by Cloud Run/hosting provider).
APP_URL="MY_APP_URL"

# ------------------------------------------
# Backend Server Configuration
# ------------------------------------------
# NODE_ENV: 'production' | 'development' | 'test'
NODE_ENV="development"

# DATABASE_URL: PostgreSQL connection string.
# In development, defaults to local postgres or in-memory fallback.
# In production, this variable is MANDATORY.
DATABASE_URL="postgresql://pathflow:pathflow_secret@localhost:5432/pathflow_db?schema=public"

# AUTH_SECRET: Key used to sign and verify JWT authentication tokens.
# In production, must be at least 32 characters and cannot use default placeholders.
AUTH_SECRET="change-this-to-a-secure-random-32char-secret-in-production"

# CORS_ALLOWED_ORIGINS: Comma-separated list of permitted frontend origins.
# In production, wildcard '*' is strictly rejected. Use your actual frontend domain(s).
# Example: "https://pathflow.example.com,https://app.pathflow.example.com"
CORS_ALLOWED_ORIGINS="http://localhost:3000"

# Server Network Binding
PORT=3001
HOST="0.0.0.0"

# ------------------------------------------
# Frontend Client Configuration
# ------------------------------------------
# VITE_BACKEND_URL: Base URL of the Fastify backend server.
# Injected at build time by Vite.
# In development, defaults to 'http://localhost:3001'.
# In production, defaults to window.location.origin if hosted under a reverse proxy.
# Example: "https://api.pathflow.example.com"
VITE_BACKEND_URL="http://localhost:3001"
